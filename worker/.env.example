# EagleCapital worker — copy to .env and fill in.
#
# This is the ONLY config file the worker reads. There is no repo-root .env and
# no override chain: what is here is what runs.

# ── Control plane ───────────────────────────────────────────────────────────
# The direct database connection -- the main path. One pooled connection to
# Supabase, as the copier_worker role (supabase/migrations-worker-direct.sql).
# Commands and config changes are PUSHED down it, so a Close in the app reaches
# this machine in milliseconds, and it costs no Edge Function invocations.
#
# Supabase -> Connect -> Session pooler, then swap the user for
# copier_worker.<project-ref> and the password for the one you gave the role:
# WORKER_DATABASE_URL=postgresql://copier_worker.onbirijlwcxykdgxxsvy:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Same value as the ENCRYPTION_KEY secret in Supabase. Lets the worker read its
# config straight from the database: broker passwords are stored encrypted, and
# this machine decrypts them. Without it, config alone is read via the gateway.
# (Not a new exposure: this machine already receives every broker password --
# MT5 needs it to log in.)
# ENCRYPTION_KEY=

# The copier gateway: the FALLBACK whenever the database cannot answer, so an
# outage costs gateway invocations for its duration, never a lost command.
# Keep it configured. Same Supabase project as the app; no separate service.
API_URL=https://onbirijlwcxykdgxxsvy.supabase.co/functions/v1/copier-gateway

# Must match the WORKER_API_KEY secret in Supabase
# (Project Settings -> Edge Functions -> Secrets). Sent as X-Worker-Key.
WORKER_API_KEY=

# Your EagleCapital auth.users id — NOT a delta_engine one.
#   select id, email from auth.users where email = 'you@example.com';
# The mistake this catches: a worker with the wrong id connects fine,
# authenticates fine, and then reports zero accounts. That looks like a broken
# install rather than a wrong number, and costs an hour.
WORKER_USER_ID=

# Accounts and copy links come from the dashboard, not from config/*.yaml.
DELTA_CONFIG_SOURCE=api

# ── This machine ────────────────────────────────────────────────────────────
WORKER_NAME=eagle-win-01
WORKER_REGION=home
WORKER_CAPACITY=5

# ── Timeouts ────────────────────────────────────────────────────────────────
WORKER_API_READ_TIMEOUT_SECONDS=90
WORKER_API_CONNECT_TIMEOUT_SECONDS=15

# How long to wait between polls when there is nothing armed to run.
WORKER_IDLE_POLL_SECONDS=15

# Commands (Close, Test connection, flatten) are pushed over the database
# connection. These are only the safety net: how often to check anyway while
# the push is connected, and while it is not.
# WORKER_COMMAND_SAFETY_POLL_SECONDS=30
# WORKER_COMMAND_POLL_SECONDS=2

# How often to journal closed positions to the dashboard. A close the copier
# made itself is journalled within seconds regardless; this beat is what picks
# up a position closed by hand in MT5. Leave unset (10s) -- an old 120 here
# made hand-closed trades take two minutes to reach the dashboard.
# WORKER_TRADE_SYNC_SECONDS=10

# ── Terminals ───────────────────────────────────────────────────────────────
# Where to look for MT5 installs. The worker assigns each account a free one
# matching its broker, so nobody has to type a path. Semicolon-separated.
# Default: C:\MT5 ; C:\Program Files ; C:\Program Files (x86)
# WORKER_TERMINAL_ROOTS=C:\MT5;D:\Terminals

# ── Optional: the signal bus ────────────────────────────────────────────────
# Leave off for the first run so you have a baseline to compare against. Once
# copying works, set to 1, then compile mql5/DeltaEngineSignalBus.mq5 into the
# MASTER terminal and attach it to any chart. Detection goes from a 50 ms poll
# to event-driven.
# WORKER_SIGNAL_BUS_ENABLED=1
