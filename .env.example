# Copy to .env.local and fill in from your Supabase project's Settings -> API page.
# This project is shared with Delta Engine (github.com/richmondazadze/delta_engine) — one
# Supabase project, one login, for both EagleCapital and the Trade Copier page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Delta Engine's FastAPI backend address — only needed for the Trade Copier page.
VITE_DELTA_API_URL=https://your-delta-engine-backend.example.com
