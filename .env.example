# Copy to .env.local and fill in from your Supabase project's Settings -> API page.
# Delta Engine (github.com/richmondazadze/delta_engine) — the trade copier's control
# plane and Windows workers — now shares THIS Supabase project. Its tables were moved
# here by supabase/delta-engine-schema.sql; run that file before the copier will work.
# One project means one login: signing into EagleCapital IS signing into the copier.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NOTE: VITE_DELTA_API_URL is gone. The copier's control plane is now the
# `copier-gateway` Edge Function in THIS Supabase project, so its address is
# derived from VITE_SUPABASE_URL above. One less URL to get wrong — the previous
# architecture got exactly that wrong, shipping a copier pointed at localhost.

# Financial Modeling Prep free API key — needed for the price chart on the Trade
# Journal's Chart tab. (The Economic Calendar moved to a Supabase Edge Function
# proxying ForexFactory and no longer uses this.)
# Sign up free (no card) at https://site.financialmodelingprep.com/register
VITE_FMP_API_KEY=your-fmp-api-key

# eaglecapital-broker-sync backend — Broker Connections' Tradovate/MT5 credential
# submission and "Sync now", plus the Live Positions page. This is a SEPARATE service
# from the copier and is not currently deployed; leave blank unless you are running it
# locally. Those pages disable themselves cleanly when it is unset or unreachable.
VITE_BROKER_SYNC_API_URL=

# Sentry DSN (Project Settings -> Client Keys (DSN) on your React project) — error/performance
# monitoring. Optional: the app runs fine with this blank, Sentry just won't receive anything.
VITE_SENTRY_DSN=

# PostHog project API key (Project Settings -> Project API Key) — usage analytics. Optional, same
# "blank = disabled" pattern. VITE_POSTHOG_HOST defaults to PostHog's US cloud if left blank; set
# it explicitly if your project is on EU cloud or self-hosted.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=

# ── Supabase Edge Function secrets (set with `supabase secrets set`, NOT here) ──
# These are server-side only and must never be given a VITE_ prefix, which would
# bundle them into the browser build:
#   GROQ_API_KEY / ANTHROPIC_API_KEY  — AI Insights provider (whichever is set)
#   INSIGHTS_DAILY_LIMIT              — per-user daily cap, defaults to 10
#   PURGE_SECRET                      — shared secret for purge-deleted-accounts
#
#   WORKER_API_KEY                    — shared secret the Windows worker sends as
#                                       X-Worker-Key to copier-gateway
#   ENCRYPTION_KEY                    — 64 hex chars; AES-256-GCM key for broker
#                                       passwords. CANNOT be rotated casually —
#                                       changing it makes every connected account
#                                       unreadable until re-entered.
# See DEPLOY.md and WORKER.md.
