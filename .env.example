# Copy to .env.local and fill in from your Supabase project's Settings -> API page.
# This project is shared with Delta Engine (github.com/richmondazadze/delta_engine) — one
# Supabase project, one login, for both EagleCapital and the Trade Copier page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Delta Engine's FastAPI backend address — only needed for the Trade Copier page.
VITE_DELTA_API_URL=https://your-delta-engine-backend.example.com

# Financial Modeling Prep free API key — only needed for the Economic Calendar page.
# Sign up free (no card) at https://site.financialmodelingprep.com/register
VITE_FMP_API_KEY=your-fmp-api-key

# eaglecapital-broker-sync backend address — only needed for the Broker Connections page's
# live Tradovate sync (credential submission + manual "Sync now").
VITE_BROKER_SYNC_API_URL=http://localhost:8787
